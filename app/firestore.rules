rules_version = '2';

// 初版ドラフト(TASKS.md Phase 0)。コンテンツ系コレクション(問題集・単語帳等)は
// Phase 3でスキーマが固まり次第ルールを追加する。Phase 9で網羅的にテストする。
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 自分自身のusersドキュメントがまだ存在しない場合(生徒の自己登録の瞬間など)、
    // get().dataへのアクセスは評価エラーになる(Firestoreルールの既知の挙動)。
    // isStaff()はあらゆる箇所から呼ばれるため、exists()で事前に存在確認してから
    // get()するガードをこの関数自体に持たせ、呼び出し順序に依存せず常に安全に
    // falseへフォールバックできるようにする。
    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myProfile().role == 'staff';
    }

    // users/{uid} — 本人は自分のプロフィールを読み書きできる。
    // staffは新規staffアカウント発行(SPEC §2.3)のため他uidのドキュメントも作成でき、
    // 承認/拒否(SPEC §2.2)のため更新もできる。
    // フィールド単位の制御(Phase 9で網羅的にテストし詳細化): 生徒が自分自身の
    // role・approvalStatusを書き換えて自己承認・staffへの権限昇格をすることを防ぐ。
    // 一方でlevel・placementTestCompletedは、自前サーバーを持たない構成のため
    // 本人のブラウザから直接書き込む必要がある(プレースメントテスト・自動昇降級、
    // SPEC §4.2)。そのため「role/approvalStatusが変化しない更新」のみ本人に許可し、
    // それ以外のフィールドの自己更新は許可する設計とした。
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();

      // isOwnerの自己登録分岐を先に評価する: 新規登録時は自分のusersドキュメントが
      // まだ存在しないため、先にisStaff()を評価するとget()が存在しないドキュメントを
      // 参照して評価エラーになる(Firestoreルールのget()は対象が存在しないと
      // .dataへのアクセスで例外になる)。isOwner側の条件はget()を使わないため、
      // 短絡評価でisStaff()に到達しない順序にする必要がある。
      allow create: if (isOwner(uid) &&
          request.resource.data.role == 'student' &&
          request.resource.data.approvalStatus == 'pending') ||
        isStaff();

      allow update: if (isOwner(uid) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.approvalStatus == resource.data.approvalStatus) ||
        isStaff();
    }

    // tasks/{taskId} — 所有者(ownerUid)のみread/write可能。共有タスク一覧は存在しない(SPEC §3)。
    match /tasks/{taskId} {
      allow read, write: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    // courses/{courseId} — 承認済みユーザーなら誰でも参照可能。作成/編集はstaffのみ。
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // levelChanges/{changeId} — 本人とstaffのみ参照可能。
    // プレースメントテスト提出時・レベル自動昇降級判定時に本人のブラウザから
    // 直接作成される(自前サーバーを持たない構成のためクライアントサイドで判定・記録する。
    // SPEC §4.2.1, §4.2.2)。改ざん防止のため更新・削除はstaffのみに限定する。
    match /levelChanges/{changeId} {
      allow read: if isSignedIn() &&
        (resource.data.studentUid == request.auth.uid || isStaff());
      allow create: if isSignedIn() &&
        (request.resource.data.studentUid == request.auth.uid || isStaff());
      allow update, delete: if isStaff();
    }

    // answerLogs/{logId} — 生徒の解答履歴。本人とstaffのみ参照可能。
    // 本人のブラウザから作成されるのみで、改ざん防止のため更新・削除は許可しない(Phase 4)。
    match /answerLogs/{logId} {
      allow read: if isSignedIn() &&
        (resource.data.studentUid == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
    }

    // settings/{settingId} — レベル判定閾値などのアプリ設定。承認済みユーザーなら
    // 誰でも参照可能(採点ロジックがクライアントサイドで動くため)。編集はstaffのみ(Phase 4)。
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // pronunciationApiUsageLogs/{logId} — 利用ログ。本人とstaffのみ参照可能。
    match /pronunciationApiUsageLogs/{logId} {
      allow read: if isSignedIn() &&
        (resource.data.studentUid == request.auth.uid || isStaff());
      allow write: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
    }

    // 学習コンテンツ(Phase 3, SPEC §4.1〜§4.3) — いずれも承認済みユーザーなら誰でも
    // 参照可能。作成/編集/削除はstaffのみ。courses/{courseId}と同じ方針。
    match /vocabCards/{cardId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /listeningMaterials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /questionSets/{setId} {
      allow read: if isSignedIn();
      allow write: if isStaff();

      match /questions/{questionId} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    // vocabReviews/{studentUid}_{vocabCardId} — 生徒ごとの単語帳SRS復習状態。
    // 本人とstaffのみ参照可能。自前サーバーを持たない構成のため、SRSの算出・書き込みは
    // 本人のブラウザから直接行う(levelChanges/answerLogsと同じ方針、Phase 6)。
    match /vocabReviews/{reviewId} {
      allow read: if isSignedIn() &&
        (resource.data.studentUid == request.auth.uid || isStaff());
      allow create, update: if isSignedIn() &&
        request.resource.data.studentUid == request.auth.uid;
    }
  }
}
