<section class="section rich-text">
  <div class="container rich-text__inner">
    {% if section.settings.heading != blank %}
      <h2 class="rich-text__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.content != blank %}
      <div class="rich-text__content">{{ section.settings.content }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "テキストブロック",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "Universal DVD Classic について"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "本文",
      "default": "<p>一つ一つの物語、丁寧に選んだDVDをお届けします。</p>"
    }
  ],
  "presets": [
    {
      "name": "テキストブロック"
    }
  ]
}
{% endschema %}
