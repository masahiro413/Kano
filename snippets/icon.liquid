{% comment %}
  Renders an inline SVG icon.
  Usage: {% render 'icon', name: 'cart' %}
  Supported names: cart, search, menu, close, chevron-down, minus, plus
{% endcomment %}
{% case name %}
  {% when 'cart' %}
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M6 6h15l-1.5 9h-12z" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="9" cy="20" r="1.4"/>
      <circle cx="18" cy="20" r="1.4"/>
      <path d="M3 3h2l1 3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {% when 'search' %}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/>
      <path d="M20 20l-4.3-4.3" stroke-linecap="round"/>
    </svg>
  {% when 'menu' %}
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"/>
    </svg>
  {% when 'close' %}
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M5 5l14 14M19 5L5 19" stroke-linecap="round"/>
    </svg>
  {% when 'chevron-down' %}
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {% when 'minus' %}
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M5 12h14" stroke-linecap="round"/>
    </svg>
  {% when 'plus' %}
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M12 5v14M5 12h14" stroke-linecap="round"/>
    </svg>
{% endcase %}
